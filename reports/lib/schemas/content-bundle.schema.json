{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "content-bundle",
  "title": "ContentBundle",
  "description": "Structured content for a report",
  "type": "object",
  "required": ["metadata", "headline", "sections"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["sessionId", "theme", "generatedAt"],
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Unique session identifier"
        },
        "theme": {
          "type": "string",
          "enum": ["journalist", "detective"],
          "description": "The report theme"
        },
        "generatedAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of generation"
        },
        "version": {
          "type": "string",
          "default": "1.0.0",
          "description": "Schema version"
        },
        "storyDate": {
          "type": "string",
          "description": "In-world article date (e.g., 2027-02-22 for journalist theme)"
        }
      },
      "additionalProperties": false
    },
    "headline": {
      "type": "object",
      "required": ["main"],
      "properties": {
        "main": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "description": "Primary headline text"
        },
        "kicker": {
          "type": "string",
          "maxLength": 100,
          "description": "Small text above main headline"
        },
        "deck": {
          "type": "string",
          "maxLength": 300,
          "description": "Subheadline under the main headline"
        }
      },
      "additionalProperties": false
    },
    "byline": {
      "type": "object",
      "properties": {
        "author": {
          "type": "string",
          "description": "Author name"
        },
        "title": {
          "type": "string",
          "description": "Author title/role"
        },
        "location": {
          "type": "string",
          "description": "Reporting location"
        },
        "date": {
          "type": "string",
          "description": "Publication date display string"
        },
        "guestReporter": {
          "type": "string",
          "description": "Guest-reporter credit, as 'Name | Role'"
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered list of article sections",
      "items": {
        "type": "object",
        "required": ["id", "type", "content"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique section identifier"
          },
          "type": {
            "type": "string",
            "enum": ["narrative", "evidence-highlight", "investigation-notes", "conclusion", "case-summary"],
            "description": "Section type"
          },
          "heading": {
            "type": "string",
            "description": "Optional section heading"
          },
          "content": {
            "type": "array",
            "description": "Content blocks within section",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["type", "text"],
                  "properties": {
                    "type": { "const": "paragraph" },
                    "text": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": ["type", "text"],
                  "properties": {
                    "type": { "const": "quote" },
                    "text": { "type": "string", "minLength": 1 },
                    "attribution": {
                      "type": "string",
                      "description": "The speaker's name"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": ["type", "tokenId"],
                  "properties": {
                    "type": { "const": "evidence-reference" },
                    "tokenId": { "type": "string" },
                    "caption": { "type": "string" }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": ["type", "items"],
                  "properties": {
                    "type": { "const": "list" },
                    "ordered": { "type": "boolean", "default": false },
                    "items": {
                      "type": "array",
                      "items": { "type": "string" },
                      "minItems": 1
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": ["type", "filename"],
                  "properties": {
                    "type": { "const": "photo" },
                    "filename": { "type": "string", "description": "Photo filename" },
                    "caption": { "type": "string", "description": "Photo caption" },
                    "characters": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Character names visible in photo"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": ["type", "tokenId", "headline", "content"],
                  "properties": {
                    "type": { "const": "evidence-card" },
                    "tokenId": { "type": "string" },
                    "headline": { "type": "string" },
                    "content": { "type": "string", "description": "The card's text" },
                    "owner": { "type": "string", "description": "Evidence owner name" },
                    "significance": {
                      "type": "string",
                      "enum": ["critical", "supporting", "contextual"],
                      "default": "supporting"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "pullQuotes": {
      "type": "array",
      "description": "Featured quotes",
      "items": {
        "type": "object",
        "required": ["type", "text"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["verbatim", "crystallization"],
            "description": "The quote's kind"
          },
          "text": { "type": "string", "description": "The quote text" },
          "attribution": {
            "type": ["string", "null"],
            "description": "The speaker's name, or null"
          },
          "sourceTokenId": {
            "type": "string",
            "description": "The id of the document quoted"
          },
          "placement": {
            "type": "string",
            "enum": ["left", "right", "center"],
            "default": "right"
          }
        },
        "additionalProperties": false
      }
    },
    "evidenceCards": {
      "type": "array",
      "description": "The sidebar's evidence entries, each a headline and a summary. Document text belongs on the inline evidence-card block in sections, not here.",
      "items": {
        "type": "object",
        "required": ["tokenId", "headline"],
        "properties": {
          "tokenId": { "type": "string", "description": "Unique evidence identifier" },
          "headline": { "type": "string", "description": "The entry's headline" },
          "content": { "type": "string", "description": "Not printed: a sidebar entry prints only its headline and summary. Leave it out; document text belongs on the inline evidence-card block." },
          "summary": { "type": "string", "description": "Brief summary for sidebar display" },
          "owner": { "type": "string", "description": "Character who owns this evidence (e.g., 'Riley Torres')" },
          "significance": {
            "type": "string",
            "enum": ["critical", "supporting", "contextual"],
            "default": "supporting",
            "description": "How important this evidence is to the narrative"
          },
          "placement": {
            "type": "string",
            "enum": ["sidebar", "inline"],
            "default": "sidebar",
            "description": "Where this evidence card should appear"
          }
        },
        "additionalProperties": false
      }
    },
    "financialTracker": {
      "type": "object",
      "description": "The ledger's accounts, one entry per account",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description", "amount"],
            "properties": {
              "date": { "type": "string", "description": "Optional. Usually omitted for shell-account entries." },
              "description": { "type": "string", "description": "The account name" },
              "amount": { "type": "string", "description": "The account total as a dollar string, e.g. '$<amount>'" },
              "category": { "type": "string", "description": "Optional. Usually 'shell-account'." }
            },
            "additionalProperties": false
          }
        },
        "totalExposed": { "type": "string", "description": "The ledger's total as a dollar string" }
      },
      "additionalProperties": false
    },
    "photos": {
      "type": "array",
      "description": "Session photos with captions",
      "items": {
        "type": "object",
        "required": ["filename", "caption"],
        "properties": {
          "filename": {
            "type": "string",
            "description": "Photo filename"
          },
          "caption": {
            "type": "string",
            "description": "Photo caption"
          },
          "characters": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Character names visible in photo"
          },
          "placement": {
            "type": "string",
            "enum": ["inline", "sidebar"],
            "default": "inline",
            "description": "Where the photo appears"
          },
          "afterSection": {
            "type": "string",
            "description": "Section ID after which photo appears"
          }
        },
        "additionalProperties": false
      }
    },
    "heroImage": {
      "type": "object",
      "description": "Featured image at top of article",
      "properties": {
        "filename": {
          "type": "string",
          "description": "Photo filename"
        },
        "caption": {
          "type": "string",
          "description": "Hero image caption"
        },
        "characters": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Character names visible in hero image"
        }
      },
      "additionalProperties": false
    },
    "voice_self_check": {
      "type": "object",
      "description": "A self-assessment",
      "properties": {
        "influences_check": {
          "type": "object",
          "description": "Check against each voice influence",
          "additionalProperties": { "type": "string" }
        },
        "mechanics_check": {
          "type": "object",
          "description": "Check against voice mechanics requirements",
          "additionalProperties": { "type": "string" }
        },
        "anti_pattern_check": {
          "type": "object",
          "description": "Check for anti-patterns",
          "additionalProperties": { "type": "string" }
        },
        "issues_found": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Issues found"
        },
        "overall_assessment": {
          "type": "string",
          "description": "Summary of voice compliance"
        }
      },
      "additionalProperties": false
    },
    "_revisionHistory": {
      "type": "array",
      "description": "Revision iterations",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string" },
          "revisionNumber": { "type": "integer" },
          "duration": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
