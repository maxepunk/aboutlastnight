{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "outline",
  "title": "ArticleOutline",
  "description": "The outline of a NovaNews article. The six section keys are slots: an outline may leave a slot out, or leave it empty.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "lede": {
      "type": "object",
      "description": "The lede's plan",
      "additionalProperties": false,
      "properties": {
        "hook": {
          "type": "string",
          "description": "The lede's opening"
        },
        "keyTension": {
          "type": "string"
        },
        "primaryArc": {
          "type": "string",
          "description": "The arc the lede opens on"
        },
        "selectedEvidence": {
          "type": "array",
          "description": "Ids of the documents the lede uses",
          "items": { "type": "string" }
        }
      }
    },
    "theStory": {
      "type": "object",
      "description": "THE STORY's plan, with how the arcs intercut across the article",
      "additionalProperties": false,
      "properties": {
        "arcInterweaving": {
          "type": "object",
          "description": "How the arcs intercut across the article, and where they converge",
          "additionalProperties": false,
          "properties": {
            "interleavingPlan": {
              "type": "string",
              "description": "How the arcs intercut"
            },
            "callbackOpportunities": {
              "type": "array",
              "description": "Details planted in one arc that pay off in another",
              "items": {
                "type": "object",
                "required": ["plantIn", "payoffIn", "detail"],
                "additionalProperties": false,
                "properties": {
                  "plantIn": { "type": "string", "description": "Arc where the detail is planted" },
                  "payoffIn": { "type": "string", "description": "Arc where the detail pays off" },
                  "detail": { "type": "string", "description": "What is planted and how it pays off" }
                }
              }
            },
            "convergencePoint": {
              "type": "string",
              "description": "The culmination where the threads meet and the thesis lands, and where in the article it falls"
            }
          }
        },
        "arcs": {
          "type": "array",
          "description": "Each arc THE STORY carries, with its plan",
          "items": {
            "type": "object",
            "required": ["name", "paragraphCount"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Arc identifier/name"
              },
              "paragraphCount": {
                "type": "integer",
                "description": "Estimated number of paragraphs for this arc"
              },
              "evidenceCards": {
                "type": "array",
                "description": "Evidence cards to include in this arc",
                "items": {
                  "type": "object",
                  "required": ["tokenId", "placement", "loopFunction"],
                  "additionalProperties": false,
                  "properties": {
                    "tokenId": { "type": "string", "description": "Document id" },
                    "placement": { "type": "string", "description": "Where in the arc the card goes (e.g., 'after para 1')" },
                    "loopFunction": {
                      "type": "string",
                      "enum": ["CLOSER", "OPENER"],
                      "description": "CLOSER proves what was hinted, OPENER raises new question"
                    }
                  }
                }
              },
              "photoPlacement": {
                "type": ["object", "null"],
                "description": "Optional photo placement within arc",
                "additionalProperties": false,
                "properties": {
                  "filename": { "type": "string", "description": "Photo filename" },
                  "afterParagraph": { "type": "integer", "description": "Place photo after this paragraph number" },
                  "purpose": {
                    "type": "string",
                    "enum": ["breathing", "humanize", "bridge"],
                    "description": "Why the photo sits here"
                  }
                }
              }
            }
          }
        }
      }
    },
    "followTheMoney": {
      "type": "object",
      "description": "FOLLOW THE MONEY's plan",
      "additionalProperties": false,
      "properties": {
        "arcConnections": {
          "type": "array",
          "description": "The arcs this section carries, each with the angle it takes; an arc it does not carry is not listed",
          "items": {
            "type": "object",
            "required": ["arcName", "financialAngle"],
            "additionalProperties": false,
            "properties": {
              "arcName": { "type": "string" },
              "financialAngle": { "type": "string", "description": "This section's angle on the arc" }
            }
          }
        },
        "shellAccounts": {
          "type": "array",
          "description": "Ledger accounts the section uses",
          "items": {
            "type": "object",
            "required": ["name", "total"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "description": "Account name" },
              "total": { "type": ["number", "string"], "description": "The account's total" },
              "inference": { "type": "string", "description": "The section's reading of the account" },
              "relatedArc": { "type": "string", "description": "The arc the account bears on" }
            }
          }
        },
        "photoPlacement": {
          "type": ["object", "null"],
          "description": "Optional photo placement",
          "additionalProperties": false,
          "properties": {
            "filename": { "type": "string" },
            "afterParagraph": { "type": "integer" },
            "purpose": { "type": "string" }
          }
        }
      }
    },
    "thePlayers": {
      "type": "object",
      "description": "THE PLAYERS' plan",
      "additionalProperties": false,
      "properties": {
        "arcConnections": {
          "type": "array",
          "description": "The arcs this section carries, each with the angle it takes; an arc it does not carry is not listed",
          "items": {
            "type": "object",
            "required": ["arcName", "characterAngle"],
            "additionalProperties": false,
            "properties": {
              "arcName": { "type": "string" },
              "characterAngle": { "type": "string", "description": "This section's angle on the arc" }
            }
          }
        },
        "exposed": {
          "type": "array",
          "description": "Character names whose memories were exposed",
          "items": { "type": "string" }
        },
        "characterHighlights": {
          "type": "object",
          "description": "Character moments to highlight, by character name",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "whatsMissing": {
      "type": "object",
      "description": "WHAT'S MISSING's plan",
      "additionalProperties": false,
      "properties": {
        "arcConnections": {
          "type": "array",
          "description": "The arcs this section carries, each with the question it raises; an arc it does not carry is not listed",
          "items": {
            "type": "object",
            "required": ["arcName", "openQuestion"],
            "additionalProperties": false,
            "properties": {
              "arcName": { "type": "string" },
              "openQuestion": { "type": "string", "description": "The open question this section raises about the arc" }
            }
          }
        },
        "knownUnknowns": {
          "type": "array",
          "description": "The open questions the section raises",
          "items": { "type": "string" }
        },
        "narrativePurpose": {
          "type": "string",
          "description": "What the section does for the reader"
        }
      }
    },
    "closing": {
      "type": "object",
      "description": "The closing's plan",
      "additionalProperties": false,
      "properties": {
        "arcResolutions": {
          "type": "array",
          "description": "The arcs the closing carries, each with where it ends; an arc it does not carry is not listed",
          "items": {
            "type": "object",
            "required": ["arcName", "resolution"],
            "additionalProperties": false,
            "properties": {
              "arcName": { "type": "string" },
              "resolution": { "type": "string", "description": "Where the arc ends in the closing" }
            }
          }
        },
        "systemicAngle": {
          "type": "string"
        },
        "accusationHandling": {
          "type": "string",
          "description": "How the closing presents the verdict"
        },
        "finalLine": {
          "type": "string",
          "description": "The closing line of the article"
        }
      }
    }
  }
}
